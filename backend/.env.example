# Content Diagnostics Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required for Production
# ===========================================

# Database (set in docker-compose for local dev)
# DB_URL=jdbc:postgresql://localhost:5432/contentdiagnostics
# DB_USER=postgres
# DB_PASS=postgres

# JWT Secret (min 256 bits for HS256)
JWT_SECRET=your-256-bit-secret-key-change-in-production

# ===========================================
# Stripe Configuration
# ===========================================
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Leave empty to use mock mode (simulates checkout without real Stripe)

# Stripe Secret Key (starts with sk_test_ for test mode)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe Webhook Secret
# Option 1: Use Stripe CLI (recommended for local dev)
#   Run: docker compose --profile stripe up -d
#   Then: docker logs contentdiag-stripe (shows whsec_xxx secret)
# Option 2: Create webhook in Dashboard for deployed environments
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for subscription plans
# Create in Stripe Dashboard > Products, or via CLI:
#   stripe products create --name="Starter" --description="5 reviewers, 3 videos/month"
#   stripe prices create --product=prod_xxx --unit-amount=4900 --currency=usd -d "recurring[interval]=month"
STRIPE_PRICE_BASIC=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx

# ===========================================
# Docker Compose Commands
# ===========================================
# Start all services:
#   docker compose up -d
#
# Start with Stripe CLI webhook forwarding:
#   docker compose --profile stripe up -d
#
# Trigger test events:
#   docker exec contentdiag-stripe stripe trigger checkout.session.completed
#   docker exec contentdiag-stripe stripe trigger customer.subscription.updated

# ===========================================
# Email (Optional for local dev)
# ===========================================

# Resend API Key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Observability (Optional)
# ===========================================

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
SENTRY_DSN=

# ===========================================
# Local Development Only
# ===========================================

# Debug tools (only enable in dev)
DEBUG_TOOLS_ENABLED=true
